# Copy to .env and fill in. Never commit .env.

# REQUIRED for online SEC ingestion (SEC fair-access policy: descriptive User-Agent with real contact info).
# Replace the placeholder with YOUR dedicated project email in your local .env (never commit .env):
SEC_USER_AGENT=FinGuardAI your-project-email@example.com

# Optional. Raises OpenFIGI rate limits / batch size. Leave empty for anonymous access.
OPENFIGI_API_KEY=

# Optional, only for the real LLM agent (--agent llm)
ANTHROPIC_API_KEY=
FINGUARD_LLM_MODEL=claude-sonnet-5-5

# Local Ollama via its OpenAI-compatible API (use: --agent llm --provider openai) or native API (--provider ollama):
#   OPENAI_API_KEY=ollama
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   FINGUARD_LLM_MODEL=qwen2.5:3b
# Optional generation / timeout overrides (defaults in config/settings.yaml `llm:`):
#   FINGUARD_MAX_OUTPUT_TOKENS=700  FINGUARD_NUM_CTX=4096  FINGUARD_TEMPERATURE=0  FINGUARD_READ_TIMEOUT=300
#   FINGUARD_JSON_MODE=1  FINGUARD_MAX_ATTEMPTS=3  FINGUARD_TIMEOUT_RETRIES=1

# Optional OpenAI-compatible endpoint alternative (--agent llm --provider openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
